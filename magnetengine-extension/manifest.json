{
  "manifest_version": 3,
  "name": "MagnetEngine — DM Campaign Sender",
  "version": "1.7.0",
  "description": "Sends the Instagram DMs you approve in your MagnetEngine dashboard and syncs the replies back to your inbox, at a human pace.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://magnetengine.xyz/*",
    "https://*.magnetengine.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://magnetengine.xyz/*",
        "https://*.magnetengine.xyz/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "protocol.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*.instagram.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
