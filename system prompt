from anthropic import Anthropic
from tenacity import retry, stop_after_attempt, wait_exponential
from models import LeadProfile, CampaignConfig, GeneratedDM
from prompt_renderer import render_system_prompt

class MagnetEngineAI:
    def __init__(self):
        self.client = Anthropic(api_key=os.getenv("ANTHROPIC_API_KEY"))
        self.model = os.getenv("ANTHROPIC_MODEL", "claude-3-5-haiku-20241022")
        self.max_tokens = 80
        self.temperature = 0.4
        self._prompt_cache = {}  # campaign_id -> system_prompt
        self._api_cache = {}     # prompt_hash -> timestamp
    
    def _build_user_message(self, lead: LeadProfile) -> str:
        parts = [
            f"Handle: @{lead.handle}",
            f'Bio: "{lead.bio}"',
            f"Followers: {lead.follower_count:,}",
            f"Business: {'Yes' if lead.is_business else 'No'}",
        ]
        if lead.recent_post:
            parts.append(f'Recent post: "{lead.recent_post[:200]}"')
        if lead.location:
            parts.append(f"Location: {lead.location}")
        if lead.niche_category:
            parts.append(f"Category: {lead.niche_category}")
        return "\n".join(parts)
    
    def _cache_key(self, system_prompt: str) -> str:
        return hashlib.sha256(system_prompt.encode()).hexdigest()[:16]
    
    @retry(stop=stop_after_attempt(3), wait=wait_exponential(1, 2, 10))
    def generate_dm(self, lead: LeadProfile, config: CampaignConfig) -> GeneratedDM:
        start = time.time()
        
        # Render client-specific system prompt
        system_prompt = render_system_prompt(config)
        cache_key = self._cache_key(system_prompt)
        
        # Track cache status
        cached = cache_key in self._api_cache
        if not cached:
            self._api_cache[cache_key] = time.time()
        
        # API call
        response = self.client.messages.create(
            model=self.model,
            max_tokens=self.max_tokens,
            temperature=self.temperature,
            system=system_prompt,
            messages=[{"role": "user", "content": self._build_user_message(lead)}]
        )
        
        dm_text = response.content[0].text.strip()
        
        # Quality scoring
        stars = self._quality_score(dm_text, lead, config)
        
        # Cost: Haiku pricing
        cost = (response.usage.input_tokens * 0.0000008 + 
                response.usage.output_tokens * 0.0000004)
        
        return GeneratedDM(
            lead_handle=lead.handle,
            dm_text=dm_text,
            star_rating=stars,
            cached=cached,
            cost_usd=round(cost, 6),
            generation_time_ms=int((time.time() - start) * 1000)
        )
    
    def _quality_score(self, text: str, lead: LeadProfile, config: CampaignConfig) -> int:
        stars = 0
        
        # 1. References lead's handle or bio content
        bio_words = set(w.lower() for w in lead.bio.split() if len(w) > 3)
        dm_words = set(w.lower() for w in text.split() if len(w) > 3)
        if lead.handle.lower() in text.lower() or len(bio_words & dm_words) >= 2:
            stars += 1
        
        # 2. No product pitch in first DM
        forbidden = [config.business_name.lower(), "my tool", "my software", 
                      "automation", "i help", "we offer", "our company",
                      "quick question", "just wanted to", "would love to",
                      "leverage", "synergies", "optimize", "strategize"]
        if not any(f in text.lower() for f in forbidden):
            stars += 1
        
        # 3. Two sentences
        sentences = [s.strip() for s in text.replace('?', '.').replace('!', '.').split('.') if s.strip()]
        if len(sentences) == 2:
            stars += 1
        
        # 4. Ends with question
        if text.strip().endswith('?'):
            stars += 1
        
        # 5. Process-oriented question (not generic)
        process_words = ["outreach", "prospect", "client", "calendar", "dm", 
                        "manual", "system", "finding", "booking", "process",
                        "how do you", "are you", "do you", "what's your"]
        if any(w in text.lower() for w in process_words):
            stars += 1
        
        return max(1, min(5, stars))


