{
  "manifest_version": 3,
  "name": "MagnetEngine — DM Campaign Sender",
  "version": "1.4.0",
  "description": "Sends the Instagram DMs you approved in your MagnetEngine dashboard, reads replies back into your inbox, and drips follow-ups — with human-like pacing and a daily safety cap.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://magnetengine.xyz/*",
    "https://*.magnetengine.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "https://magnetengine.xyz/*",
        "https://*.magnetengine.xyz/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "protocol.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
