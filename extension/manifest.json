{
  "manifest_version": 3,
  "name": "MagnetEngine – AI Appointment Setter & Instagram DM Automation",
  "version": "1.9.0",
  "minimum_chrome_version": "111",
  "description": "AI appointment setter for Instagram: sends the AI-written DMs and follow-ups you approve, then syncs the replies so you book calls.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://magnetengine.xyz/*",
    "https://*.magnetengine.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "https://magnetengine.xyz/*",
        "https://*.magnetengine.xyz/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "protocol.js",
        "igparse.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "js": [
        "igpage.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://*.instagram.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
