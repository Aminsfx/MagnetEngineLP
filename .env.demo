# `npm run demo` — loaded on top of .env (Supabase stays configured, so login,
# the queue and DM generation are all real). Only the scrape step is faked:
# the Campaign Builder returns generated sample profiles instead of calling the
# `scrape` Edge Function, so it can be tried without a HikerAPI key.
#
# Every sample handle contains a hyphen, which Instagram usernames cannot, so a
# sample Lead can never be a real person's account.
VITE_SCRAPE_DEMO=true
