# ─── MagnetEngine Environment Variables (template) ───────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — this file IS committed as a reference.

# Apify — Instagram scraper API key
VITE_APIFY_API_KEY=your_apify_api_key_here
# Optional: override the followers/following scraper actor (requires paid Apify plan)
# VITE_APIFY_FOLLOWERS_ACTOR_ID=

# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI providers — centrally managed by owner, billed to owner, never shown to clients
# ⚠️  WARNING: everything prefixed VITE_ is embedded in the client JavaScript
#     bundle and can be extracted by any user. Until API calls are moved behind
#     a backend proxy (e.g. Supabase Edge Functions), set LOW spending limits
#     on these keys and rotate them regularly. See README → Security.
VITE_OPENAI_API_KEY=your_openai_key_here
VITE_CLAUDE_API_KEY=your_claude_key_here
VITE_GEMINI_API_KEY=your_gemini_key_here

# Polar.sh checkout links — one plan, two billing cycles (see docs/POLAR_SETUP.md)
# Shown on the /activate page after sign-up.
# Leave empty to fall back to the contact email (support@magnetengine.xyz).
VITE_PAYMENT_LINK_MONTHLY=
VITE_PAYMENT_LINK_ANNUAL=
