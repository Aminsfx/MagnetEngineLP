# ─── MagnetEngine Environment Variables (template) ───────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — this file IS committed as a reference.
#
# IMPORTANT: everything prefixed VITE_ is embedded in the client JS bundle and
# is readable by anyone. ONLY non-secret, public values belong here. All secret
# API keys live server-side as Supabase Edge Function secrets — see the bottom
# of this file and README → "Frontend vs backend env".

# ── Frontend (public — safe to ship in the browser bundle) ───────────────────

# Supabase — from your project dashboard → Settings → API.
# The anon/publishable key is designed to be public; RLS protects the data.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Whop embedded checkout plan IDs (plan_...) — public identifiers shown in the
# checkout embed on /activate. See docs/WHOP_SETUP.md.
VITE_WHOP_PLAN_ID_MONTHLY=
VITE_WHOP_PLAN_ID_ANNUAL=

# Owner emails (comma-separated) — unlocks the /admin console + sidebar item.
# UI visibility only; the admin-api Edge Function enforces its own ADMIN_EMAILS
# secret server-side.
VITE_ADMIN_EMAILS=

# ── Backend (SECRET — never in .env / never VITE_-prefixed) ──────────────────
# These are set on Supabase, not here, and are used only by the Edge Functions.
# The browser never receives them.
#
#   supabase secrets set CLAUDE_API_KEY=sk-ant-...          # generate-dm
#   supabase secrets set OPENAI_API_KEY=sk-...              # generate-dm (optional)
#   supabase secrets set GEMINI_API_KEY=...                 # generate-dm (optional)
#   supabase secrets set APIFY_API_KEY=apify_api_...        # start-scrape / poll-scrape
#   supabase secrets set APIFY_FOLLOWERS_ACTOR_ID=...       # (optional override)
#   supabase secrets set WHOP_WEBHOOK_SECRET=ws_...         # whop-webhook
#   supabase secrets set WHOP_PLAN_ID_MONTHLY=plan_...      # whop-webhook (optional)
#   supabase secrets set WHOP_PLAN_ID_ANNUAL=plan_...       # whop-webhook (optional)
#   supabase secrets set ADMIN_EMAILS=you@example.com       # admin-api
#
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into functions.)
