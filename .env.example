# ─── MagnetEngine Environment Variables (template) ───────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — this file IS committed as a reference.

# Apify — Instagram scraper API key
VITE_APIFY_API_KEY=your_apify_api_key_here

# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI providers — centrally managed by owner, billed to owner, never shown to clients
VITE_OPENAI_API_KEY=your_openai_key_here
VITE_CLAUDE_API_KEY=your_claude_key_here
VITE_GEMINI_API_KEY=your_gemini_key_here
